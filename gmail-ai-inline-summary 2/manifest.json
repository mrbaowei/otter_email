{
  "manifest_version": 3,
  "name": "Email Otter - AI 邮件摘要",
  "version": "0.7.20",
  "description": "打开 Gmail、Outlook、Yahoo、iCloud、163邮箱、126邮箱或 QQ邮箱邮件时自动生成中文摘要。",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://mail.qq.com/*",
    "https://wx.mail.qq.com/*",
    "https://mail.126.com/*",
    "https://mail.163.com/*",
    "https://mail.yahoo.com/*",
    "https://www.icloud.com/*",
    "https://icloud.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Email Otter - AI 邮件摘要",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://mail.qq.com/*",
        "https://wx.mail.qq.com/*",
        "https://mail.126.com/*",
        "https://mail.163.com/*",
        "https://mail.yahoo.com/*",
        "https://www.icloud.com/*",
        "https://icloud.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": ["site-adapters.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "otter_orb.png",
        "otter-loading.gif",
        "assets/icon-128.png",
        "assets/icons/lucide-copy.svg",
        "assets/icons/lucide-refresh-cw.svg",
        "assets/icons/lucide-settings.svg",
        "assets/icons/lucide-check.svg",
        "assets/icons/lucide-triangle-alert.svg"
      ],
      "matches": [
        "https://mail.google.com/*",
        "https://mail.qq.com/*",
        "https://wx.mail.qq.com/*",
        "https://mail.126.com/*",
        "https://mail.163.com/*",
        "https://mail.yahoo.com/*",
        "https://www.icloud.com/*",
        "https://icloud.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ]
    }
  ]
}
